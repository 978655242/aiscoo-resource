{
  "version": 1,
  "caseName": "aiscoo-data-directory",
  "spec": "./test/e2e/conversation-session/aiscoo-data-directory.test.ts",
  "fixtures": [
    {
      "id": "acdd-title",
      "description": "Aiscoo 目录验收的稳定任务标题。",
      "metadata": {
        "kind": "common",
        "source": "synthetic",
        "timingPolicy": "fast-text",
        "syntheticReason": "标题使用本例 marker 隔离，不访问真实模型。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_ACDD_"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "acdd-title",
          "inputTokens": 64,
          "outputTokens": 8,
          "text": "{\"title\":\"Aiscoo Directory Acceptance\"}"
        }
      }
    },
    {
      "id": "acdd-before-main",
      "description": "真实只读工具返回后完成迁移前任务。",
      "metadata": {
        "kind": "main",
        "source": "synthetic",
        "timingPolicy": "fast-text",
        "syntheticReason": "common fixture 发起真实 Read，此响应只在真实 tool_result 返回后完成任务。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "E2E_ACDD_BEFORE",
          "toolu_e2e_conversation_readonly_read",
          "tool_result",
          "E2E_READONLY_TOOL_FILE_CONTENT"
        ],
        "bodyExcludes": ["Generate a concise title", "E2E_ACDD_AFTER"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "acdd-before-main",
          "inputTokens": 128,
          "outputTokens": 8,
          "text": "ACDD_BEFORE_DONE"
        }
      }
    },
    {
      "id": "acdd-after-main",
      "description": "完整冷重启后在原任务消费旧历史并完成续聊。",
      "metadata": {
        "kind": "main",
        "source": "synthetic",
        "timingPolicy": "fast-text",
        "syntheticReason": "请求必须携带迁移前 assistant 与真实只读工具结果，避免新空会话假装恢复成功。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_ACDD_AFTER"],
        "bodyIncludes": ["ACDD_BEFORE_DONE", "E2E_READONLY_TOOL_FILE_CONTENT"],
        "bodyExcludes": ["Generate a concise title"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "acdd-after-main",
          "inputTokens": 192,
          "outputTokens": 8,
          "text": "ACDD_AFTER_DONE"
        }
      }
    }
  ]
